#!/usr/bin/env sh
# Compatibility launcher. Prefer: android-setup setup PROFILE
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(dirname -- "$SCRIPT_DIR")"
export PYTHONPATH="$REPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

exec python3 -m android_setup --root "$REPO_ROOT" setup "$@"
