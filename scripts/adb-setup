#!/usr/bin/env sh
# adb_setup.sh — install APKs, push backups, create directories on the phone.
# Requires: download.py to have been run first.
# Run from repo root: ./scripts/adb_setup.sh

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

APKS_DIR="$REPO_ROOT/apks"
BACKUPS_DIR="$REPO_ROOT/backups"

# ── Destination on phone ───────────────────────────────────────────────────
PHONE_DOWNLOAD="/sdcard/Download"

# ── Package names — used to check if an app is already installed ───────────
PKG_SHIZUKU="moe.shizuku.privileged.api"
PKG_OBTANIUM="dev.imranr98.obtainium"
PKG_MIXPLORER="com.mixplorer.silver"

# ── Directories to create on the phone ────────────────────────────────────
PHONE_DIRS="
/sdcard/Download/DyomiSY
/sdcard/Download/Gallery
/sdcard/Download/GameSaves
/sdcard/Download/Infinity
/sdcard/Download/Mihon
/sdcard/Download/Revanced
/sdcard/Download/Twitter
/sdcard/Download/Aegis
/sdcard/Download/CustomDNS
/sdcard/Download/LinkSheet
/sdcard/Download/Mix
/sdcard/Download/MihonPreview
/sdcard/Download/Obtanium
/sdcard/Download/Fonts
/sdcard/Download/TachiyomiSY
/sdcard/Download/FolderSync
"

# ── Colours ────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# ── Logging ────────────────────────────────────────────────────────────────
log_info() { printf "${BLUE}[INFO]${RESET}  %s\n" "$*"; }
log_ok() { printf "${GREEN}[OK]${RESET}    %s\n" "$*"; }
log_skip() { printf "${DIM}[SKIP]  %s${RESET}\n" "$*"; }
log_warn() { printf "${YELLOW}[WARN]${RESET}  %s\n" "$*"; }
log_error() { printf "${RED}[ERROR]${RESET} %s\n" "$*" >&2; }
log_section() { printf "\n${BOLD}==> %s${RESET}\n" "$*"; }

# ── Helpers ────────────────────────────────────────────────────────────────

check_adb() {
	if ! command -v adb >/dev/null 2>&1; then
		log_error "adb not found — install Android Platform Tools first"
		return 1
	fi
	log_ok "adb found"
	return 0
}

check_device() {
	log_section "Device check"
	if ! adb get-state >/dev/null 2>&1; then
		log_error "No device detected — pair your phone first:"
		log_error "  adb pair <ip>:<port>"
		return 1
	fi
	model=$(adb shell getprop ro.product.model 2>/dev/null | tr -d '\r')
	log_ok "Connected: $model"
	return 0
}

check_local_file() {
	path="$1"
	if [ ! -f "$path" ] || [ ! -s "$path" ]; then
		log_error "File missing or empty: $path"
		log_error "Run 'python3 scripts/download.py' first"
		return 1
	fi
	return 0
}

# Return 0 (true) if the given package name is installed on the phone.
apk_installed() {
	pkg="$1"
	result=$(adb shell pm list packages "$pkg" 2>/dev/null | tr -d '\r')
	# pm list packages outputs "package:<name>" for each match
	[ -n "$result" ]
}

# Return 0 (true) if the given path exists as a directory on the phone.
phone_dir_exists() {
	adb shell "[ -d '$1' ]" >/dev/null 2>&1
}

install_apk() {
	apk_path="$1"
	label="$2"
	pkg="$3" # package name for already-installed check (optional)

	log_section "Installing $label"
	check_local_file "$apk_path" || return 1

	# Skip install if the package is already present on the device.
	# We still use -r (replace) when we do install so a manual downgrade
	# or re-run after a version bump works correctly.
	if [ -n "$pkg" ] && apk_installed "$pkg"; then
		log_skip "$label already installed ($pkg)"
		return 0
	fi

	if adb install -r "$apk_path"; then
		log_ok "$label installed"
		return 0
	else
		log_error "Failed to install $label"
		return 1
	fi
}

push_file() {
	src="$1"
	dest_dir="$2"
	label="$3"
	log_info "Pushing $label → $dest_dir"

	check_local_file "$src" || return 1

	if adb push "$src" "$dest_dir/$(basename "$src")"; then
		log_ok "Pushed: $label"
		return 0
	else
		log_error "Failed to push: $label"
		return 1
	fi
}

create_phone_dir() {
	path="$1"

	if phone_dir_exists "$path"; then
		log_skip "Dir exists: $path"
		return 0
	fi

	if adb shell mkdir -p "$path" >/dev/null 2>&1; then
		log_ok "Created: $path"
		return 0
	else
		log_error "Failed to create: $path"
		return 1
	fi
}

# Find the latest file matching a glob pattern in a local directory.
find_file() {
	dir="$1"
	pattern="$2"
	found=$(find "$dir" -maxdepth 1 -name "$pattern" 2>/dev/null | sort | tail -1)
	printf "%s" "$found"
}

# ── Steps ──────────────────────────────────────────────────────────────────

step_install_apks() {
	log_section "Installing APKs"
	errors=0

	shizuku_apk=$(find_file "$APKS_DIR" "shizuku-*-release.apk")
	install_apk "$shizuku_apk" "Shizuku" "$PKG_SHIZUKU"
	errors=$((errors + $?))

	obtanium_apk=$(find_file "$APKS_DIR" "app-arm64-v8a-release.apk")
	[ -z "$obtanium_apk" ] && obtanium_apk=$(find_file "$APKS_DIR" "app-release.apk")
	install_apk "$obtanium_apk" "Obtanium" "$PKG_OBTANIUM"
	errors=$((errors + $?))

	mixplorer_apk=$(find_file "$APKS_DIR" "MiXplorer_*.apk")
	install_apk "$mixplorer_apk" "MiXplorer" "$PKG_MIXPLORER"
	errors=$((errors + $?))

	return $errors
}

step_push_files() {
	log_section "Pushing files to $PHONE_DOWNLOAD"
	errors=0

	# ── APKs ──────────────────────────────────────────────────────────────
	shizuku_apk=$(find_file "$APKS_DIR" "shizuku-*-release.apk")
	push_file "$shizuku_apk" "$PHONE_DOWNLOAD" "shizuku apk"
	errors=$((errors + $?))

	obtanium_apk=$(find_file "$APKS_DIR" "app-arm64-v8a-release.apk")
	[ -z "$obtanium_apk" ] && obtanium_apk=$(find_file "$APKS_DIR" "app-release.apk")
	push_file "$obtanium_apk" "$PHONE_DOWNLOAD" "obtanium apk"
	errors=$((errors + $?))

	mixplorer_apk=$(find_file "$APKS_DIR" "MiXplorer_*.apk")
	push_file "$mixplorer_apk" "$PHONE_DOWNLOAD" "mixplorer apk"
	errors=$((errors + $?))

	# ── Backups ───────────────────────────────────────────────────────────
	obtanium_backup=$(find_file "$BACKUPS_DIR" "obtainium-export-*.json")
	push_file "$obtanium_backup" "$PHONE_DOWNLOAD" "obtanium backup"
	errors=$((errors + $?))

	# FolderSync: download.py extracts the archive so the raw .db file is
	# what lives in backups/ — push that directly, no zip on the phone.
	foldersync_backup=$(find_file "$BACKUPS_DIR" "*.db")
	if [ -z "$foldersync_backup" ]; then
		foldersync_backup=$(find_file "$BACKUPS_DIR" "*foldersync*")
		log_warn "Extracted FolderSync .db not found — pushing raw archive instead"
	fi
	push_file "$foldersync_backup" "$PHONE_DOWNLOAD" "foldersync backup"
	errors=$((errors + $?))

	return $errors
}

step_create_dirs() {
	log_section "Creating directories on phone"

	# Run in a subshell; individual failures are logged inside create_phone_dir.
	printf "%s\n" "$PHONE_DIRS" | while IFS= read -r dir; do
		[ -z "$dir" ] && continue
		create_phone_dir "$dir"
	done

	return 0
}

print_next_steps() {
	log_section "Done — next steps on your phone"
	printf "  1. Open Shizuku → pair via Wireless Debugging → tap Start\n"
	printf "  2. Open FolderSync → Settings → Backup → Restore\n"
	printf "     Select the foldersync .db file from: %s\n" "$PHONE_DOWNLOAD"
	printf "  3. Run all FolderSync sync pairs\n"
	printf "  4. Open Obtanium → Import/Export → Import\n"
	printf "     Select the obtainium-export-*.json file from: %s\n" "$PHONE_DOWNLOAD"
	printf "  5. Batch install all apps in Obtanium (Shizuku must be running)\n"
	printf "  6. Open MiXplorer and configure your preferences\n"
	printf "\n"
	printf "  On your computer:\n"
	printf "  • UAD-NG is ready at: tools/uad-ng-linux\n"
	printf "    Run it while the phone is connected to debloat system apps.\n"
}

# ── Main ───────────────────────────────────────────────────────────────────

main() {
	log_section "Android setup — ADB phase"
	total_errors=0

	check_adb || {
		log_error "Aborting: adb not available"
		return 1
	}
	check_device || {
		log_error "Aborting: no device connected"
		return 1
	}

	step_install_apks
	total_errors=$((total_errors + $?))

	step_push_files
	total_errors=$((total_errors + $?))

	step_create_dirs
	total_errors=$((total_errors + $?))

	if [ "$total_errors" -eq 0 ]; then
		print_next_steps
		log_ok "ADB setup completed successfully"
	else
		log_error "$total_errors step(s) failed — review errors above"
	fi

	return $total_errors
}

main
